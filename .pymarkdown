{
  "plugins": {

    // Do not check line length.
    "MD013": {
      "enabled": false
    },

    // HTML is not used in blog content.
    // Except in posts/categories.
    "MD033": {
      "enabled": false
    },

    // Link fragments should be valid
    "MD051": {
      "enabled": false
    }
  }
}
