{
  "plugins": {

    // Headings use the #, ##, ### format.
    // TODO: set Codex to rewrite headers.
    "MD003": {
      "enabled": false,
      "style": "atx"
    },

    // Unordered list markers.
    // set Codex to rewrite unordered lists.
    "MD004": {
      "enabled": false,
      "style": "dash"
    },

    // Indentation for nested unordered lists.
    "MD007": {
      "enabled": true,
      "indent": 2
    },

    // Do not check line length.
    "MD013": {
      "enabled": false
    },

    // Do not require $ before Bash commands.
    "MD014": {
      "enabled": false
    },

    // Do not check blank lines around headings.
    // set Codex to add blank lines around headers.
    "MD022": {
      "enabled": false
    },

    // Jekyll title is used instead of an H1 in Markdown.
    "MD025": {
      "enabled": true
    },

    // Allow punctuation at the end of headings.
    "MD026": {
      "enabled": true
    },

    // Do not check ordered-list numbering.
    // set Codex to rewrite ordered lists.
    "MD029": {
      "enabled": false,
      "style": "one"
    },

    // Check blank lines around code fences.
    "MD031": {
      "enabled": true
    },

    // Check blank lines around lists.
    "MD032": {
      "enabled": true
    },

    // HTML is not used in blog content.
    // Except in posts/categories.
    "MD033": {
      "enabled": false
    },

    // Every fenced code block must specify a language.
    "MD040": {
      "enabled": true
    },

    // Jekyll requires YAML front matter before headings.
    // TODO: set Codex to remove duplicated ---.
    "MD041": {
      "enabled": false
    }
  }
}
